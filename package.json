{
  "name": "pdfuck",
  "version": "2.1.2",
  "description": "简洁、高清、顺手的跨平台 PDF 查看、编辑、批注、打印与导出工具",
  "main": "out/main/index.js",
  "author": "github@leyuwei",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-windows-printer-native.cjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/run-vitest.cjs run",
    "test:ocr-ui": "electron-vite build && node scripts/ocr-ui-smoke.cjs",
    "test:typography": "node scripts/typography-audit.cjs",
    "test:typography-ui": "electron-vite build && node scripts/typography-ui-smoke.cjs",
    "test:annotation-dialog-ui": "electron-vite build && node scripts/annotation-dialog-interaction-ui-smoke.cjs",
    "test:annotation-editor-ui": "electron-vite build && node scripts/annotation-editor-ui-smoke.cjs",
    "test:ai-smoke": "electron-vite build && node scripts/ai-smoke.cjs",
    "test:workflow-state-ui": "electron-vite build && node scripts/workflow-state-ui-smoke.cjs",
    "test:lab-features-ui": "electron-vite build && node scripts/lab-features-ui-smoke.cjs",
    "test:creative-tools-ui": "electron-vite build && node scripts/creative-tools-ui-smoke.cjs",
    "test:selection-smoke": "electron-vite build && node scripts/selection-smoke.cjs",
    "test:selection-cpaper": "node scripts/selection-cpaper-smoke.cjs",
    "test:selection-cpaper-ui": "electron-vite build && node scripts/selection-cpaper-ui-smoke.cjs",
    "test:selection-scheduling": "node scripts/selection-scheduling-smoke.cjs",
    "test:selection-scheduling-ui": "electron-vite build && node scripts/selection-scheduling-ui-smoke.cjs",
    "test:selection-scheduling-0826": "node scripts/selection-scheduling-0826-smoke.cjs",
    "test:selection-scheduling-0826-ui": "electron-vite build && node scripts/selection-scheduling-0826-ui-smoke.cjs",
    "test:selection-test2": "node scripts/selection-test2-smoke.cjs",
    "test:selection-test2-ui": "electron-vite build && node scripts/selection-test2-ui-smoke.cjs",
    "test:selection-test3": "node scripts/selection-test3-smoke.cjs",
    "test:selection-test3-ui": "electron-vite build && node scripts/selection-test3-ui-smoke.cjs",
    "test:citations-scheduling-0826": "node scripts/citation-scheduling-0826-smoke.cjs",
    "test:reading-navigation-ui": "electron-vite build && node scripts/reading-navigation-ui-smoke.cjs",
    "test:selection-chinese": "node scripts/selection-chinese-alignment-smoke.cjs",
    "test:selection-chinese-ui": "electron-vite build && node scripts/selection-chinese-alignment-ui-smoke.cjs",
    "test:selection-bc": "node scripts/selection-bc-smoke.cjs",
    "test:selection-bc-ui": "electron-vite build && node scripts/selection-bc-ui-smoke.cjs",
    "test:heavy-image-page-ui": "electron-vite build && node scripts/heavy-image-page-ui-smoke.cjs",
    "test:selection-scheduling-inline": "node scripts/selection-scheduling-inline-formula-smoke.cjs",
    "test:selection-scheduling-inline-ui": "electron-vite build && node scripts/selection-scheduling-inline-formula-ui-smoke.cjs",
    "test:window-tabs": "electron-vite build && node scripts/window-tabs-smoke.cjs",
    "test:bookmarks-ui": "electron-vite build && node scripts/bookmark-ui-smoke.cjs",
    "test:pdf-links-ui": "electron-vite build && node scripts/pdf-links-ui-smoke.cjs",
    "test:bookmark-recognition-papers": "electron-vite build && node scripts/bookmark-recognition-papers-smoke.cjs",
    "test:page-text-edit-ui": "electron-vite build && node scripts/page-text-edit-ui-smoke.cjs",
    "test:page-manager-input-ui": "electron-vite build && node scripts/page-manager-input-ui-smoke.cjs",
    "test:i18n-catalogue": "node scripts/i18n-catalogue-audit.cjs",
    "test:i18n-ui": "electron-vite build && node scripts/i18n-ui-smoke.cjs",
    "test:print-ui": "electron-vite build && node scripts/print-ui-smoke.cjs",
    "test:print-native": "node scripts/print-native-smoke.cjs",
    "test:release-ui": "node scripts/release-ui-smoke.cjs",
    "render:icon": "electron scripts/render-app-icon.cjs",
    "test:watch": "node scripts/run-vitest.cjs",
    "build": "npm run typecheck && npm test && npm run test:i18n-catalogue && npm run test:typography && electron-vite build",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:installer": "npm run build && electron-builder --win nsis",
    "dist:win:portable": "npm run build && electron-builder --win portable",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "package:macos": "bash scripts/package-macos.sh",
    "test:selection-m91474": "node scripts/selection-m91474-smoke.cjs",
    "test:selection-m91474-ui": "electron-vite build && node scripts/selection-m91474-ui-smoke.cjs",
    "test:popups-ui": "electron-vite build && node scripts/popups-ui-smoke.cjs",
    "test:eps-vector": "electron-vite build && node scripts/eps-vector-smoke.cjs",
    "test:document-archives-ui": "electron-vite build && node scripts/document-archives-ui-smoke.cjs",
    "test:ai-settings-ui": "electron-vite build && node scripts/ai-settings-ui-smoke.cjs",
    "test:watermark": "node scripts/run-vitest.cjs run src/renderer/src/lib/watermarks.test.ts",
    "test:watermark-ui": "electron-vite build && node scripts/watermark-ui-smoke.cjs",
    "test:release-2.0.40-ui": "electron-vite build && node scripts/release-2.0.40-ui-smoke.cjs",
    "test:release-2.0.41-ui": "electron-vite build && node scripts/release-2.0.41-ui-smoke.cjs",
    "test:release-2.0.42-ui": "electron-vite build && node scripts/release-2.0.42-ui-smoke.cjs",
    "test:release-2.0.43": "node scripts/run-vitest.cjs run src/main/release-2.0.43.test.ts && electron-vite build && node scripts/release-2.0.43-ui-smoke.cjs",
    "test:release-2.0.44": "node scripts/run-vitest.cjs run src/main/release-2.0.44.test.ts && electron-vite build && node scripts/release-2.0.44-ui-smoke.cjs",
    "test:release-2.0.46": "electron-vite build && node scripts/release-2.0.46-ui-smoke.cjs",
    "test:release-2.0.47": "electron-vite build && node scripts/release-2.0.47-ui-smoke.cjs",
    "test:release-2.0.49": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.0.49.test.ts && electron-vite build && node scripts/release-2.0.49-ui-smoke.cjs",
    "test:release-2.0.50": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.0.50.test.ts && electron-vite build && node scripts/release-2.0.50-ui-smoke.cjs",
    "test:release-2.0.51": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.0.51.test.ts && electron-vite build && node scripts/release-2.0.51-ui-smoke.cjs",
    "test:release-2.0.52": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.0.52.test.tsx && electron-vite build && node scripts/release-2.0.52-ui-smoke.cjs",
    "test:release-2.0.52-fixes": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.0.52.test.tsx -t \"renders the list|hides empty|places cards\" && electron-vite build && node scripts/release-2.0.52-fixes-ui-smoke.cjs",
    "render:pdf-icon": "electron scripts/render-app-icon.cjs --mac-document",
    "test:release-2.0.55": "node scripts/run-vitest.cjs run src/main/release-2.0.55.test.ts && electron-vite build && node scripts/release-2.0.55-macos-smoke.cjs",
    "render:mac-icon": "electron scripts/render-app-icon.cjs --mac-app",
    "render:dmg-background": "electron scripts/render-app-icon.cjs --dmg-background",
    "test:macos-installer": "node scripts/macos-installer-check.cjs",
    "test:release-2.0.56": "node scripts/run-vitest.cjs run src/main/release-2.0.56.test.ts src/renderer/src/lib/release-2.0.56.test.ts && electron-vite build && node scripts/release-2.0.56-ui-smoke.cjs",
    "test:markdown": "node scripts/run-vitest.cjs run src/main/markdown.test.ts src/renderer/src/lib/markdown-document.test.tsx && electron-vite build && node scripts/markdown-ui-smoke.cjs",
    "render:windows-installer": "electron scripts/windows-installer-artwork.cjs",
    "test:release-2.1.2": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.1.2.test.ts && electron-vite build && node scripts/release-2.1.2-ui-smoke.cjs",
    "test:release-2.1.1": "node scripts/run-vitest.cjs run src/renderer/src/lib/release-2.1.1.test.tsx && electron-vite build && node scripts/release-2.1.1-ui-smoke.cjs",
    "test:windows-installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-installer-check.ps1"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "cn.pdfuck.app",
    "productName": "PDFuck",
    "copyright": "Copyright © 2026 github@leyuwei",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "artifactBuildCompleted": "scripts/macos-installer-icon.cjs",
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/{tesseract.js,tesseract.js-core,wasm-feature-detect,zlibjs,node-fetch,is-url,regenerator-runtime,idb-keyval,bmp-js,tr46,webidl-conversions,whatwg-url}/**/*",
      "node_modules/{pdf-lib,@pdf-lib,pako,tslib}/**/*",
      "out/ocr/**/*",
      "out/main/ocr-worker.js"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "PDFuck-${version}-Windows.${ext}",
      "icon": "resources/icon.ico",
      "legalTrademarks": "github@leyuwei",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF 文档",
          "mimeType": "application/pdf",
          "role": "Viewer",
          "rank": "Default"
        },
        {
          "ext": "md",
          "name": "Markdown Document",
          "description": "Markdown 文档",
          "mimeType": "text/markdown",
          "role": "Editor",
          "rank": "Default"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PDFuck",
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US",
        "ja_JP",
        "ru_RU",
        "es_ES",
        "fr_FR",
        "de_DE",
        "pt_BR",
        "ko_KR",
        "ar_SA"
      ],
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "license": "LICENSE",
      "artifactName": "PDFuck-${version}-Windows-Setup.${ext}",
      "include": "resources/installer.nsh",
      "installerHeader": "resources/installer-header.bmp",
      "installerSidebar": "resources/installer-sidebar.bmp",
      "uninstallerSidebar": "resources/installer-sidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "artifactName": "PDFuck-${version}-macOS.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeExtensions": [
              "pdf"
            ],
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "CFBundleTypeIconFile": "pdf.icns"
          },
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeExtensions": [
              "md"
            ],
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "CFBundleTypeIconFile": "pdf.icns"
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown Document",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md"
              ],
              "public.mime-type": [
                "text/markdown"
              ]
            }
          }
        ]
      },
      "extraResources": [
        {
          "from": "resources/pdf.icns",
          "to": "pdf.icns"
        }
      ]
    },
    "dmg": {
      "icon": "resources/icon.icns",
      "background": "resources/dmg-background.png",
      "iconSize": 108,
      "iconTextSize": 12,
      "window": {
        "width": 760,
        "height": 520
      },
      "contents": [
        {
          "x": 210,
          "y": 280,
          "type": "file"
        },
        {
          "x": 550,
          "y": 280,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "optionalDependencies": {
    "windows-pdf-printer-native": "2.1.1"
  }
}
